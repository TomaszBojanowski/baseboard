      <caption>The curve the board runs the CPU fan by</caption>
      <image>https://baseboard.bojanowski.me/screenshots/0.2.2/fan-curve-en.png</image>
      <image xml:lang="pl">https://baseboard.bojanowski.me/screenshots/0.2.2/fan-curve-pl.png</image>
