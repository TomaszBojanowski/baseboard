<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: CC0-1.0 -->
<component type="desktop-application">
  <id>me.bojanowski.Baseboard</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Baseboard</name>
  <summary>MSI motherboard sensors and fans</summary>
  <description>
    <p>A native GNOME app for the sensors and fans of MSI motherboards on Linux. Sensor readings work on any board. Fan header names and, later, fan control need a board profile; one is verified today: MAG B850M MORTAR WIFI.</p>
    <p>The Overview shows the processor, graphics card and board with their temperature over the last five minutes, the fans, memory and disks, and one sentence that says whether everything is fine. It warns when the processor gets very hot, when the CPU fan stops and when a voltage is outside its tolerance.</p>
    <p>The Fans page shows the speed and duty cycle of every fan, named after the headers printed on the board, and the curves the board runs them by, where the kernel driver reports them. Baseboard does not change them yet.</p>
    <p>The System page shows the board, BIOS, processor, memory, graphics card and disks, and copies the details as text for bug reports.</p>
    <p>Later versions will also control fans, onboard RGB lighting and power profiles.</p>
    <p>MSI and MSI product names are trademarks of Micro-Star International Co., Ltd. Baseboard is an independent project and is not affiliated with or endorsed by MSI.</p>
  </description>
  <url type="homepage">https://baseboard.bojanowski.me</url>
  <url type="bugtracker">https://github.com/TomaszBojanowski/baseboard/issues</url>
  <url type="vcs-browser">https://github.com/TomaszBojanowski/baseboard</url>
  <url type="donation">https://buymeacoffee.com/sojer2005</url>
  <developer id="me.bojanowski">
    <name translate="no">Tomasz Bojanowski</name>
  </developer>
  <translation type="gettext">baseboard</translation>
  <launchable type="desktop-id">me.bojanowski.Baseboard.desktop</launchable>
  <provides>
    <binary>baseboard</binary>
  </provides>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <!-- Screenshots at stable addresses that never change (D43): a new
       release gets its own folder. -->
