      <caption>Every fan with its speed and duty cycle, named after its header</caption>
      <image>https://baseboard.bojanowski.me/screenshots/0.2.2/fans-en.png</image>
      <image xml:lang="pl">https://baseboard.bojanowski.me/screenshots/0.2.2/fans-pl.png</image>
    </screenshot>
