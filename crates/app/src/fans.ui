<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <!-- The Fans page (docs/PROJEKT.md §5.5.4, §7 M2, M2.4): a note on top,
       the temperature source, the cards of the headers, the headers
       without control. fans.rs fills the groups. The breakpoints lay out
       the curve page (below 760 sp), the charts, the source and the note
       on top (below 560 sp); the cards follow their own rule by width
       (fans/layout.rs, D61). -->
  <template class="BaseboardFansPage" parent="AdwBin">
    <property name="child">
      <object class="AdwBreakpointBin" id="bin">
        <property name="width-request">360</property>
        <property name="height-request">200</property>
        <child>
          <object class="AdwBreakpoint" id="one_column">
            <condition>max-width: 760sp</condition>
          </object>
        </child>
        <child>
          <object class="AdwBreakpoint" id="narrow">
            <condition>max-width: 560sp</condition>
          </object>
        </child>
        <property name="child">
          <object class="GtkStack" id="stack">
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">status</property>
                <property name="child">
                  <object class="AdwStatusPage" id="status">
                    <property name="icon-name">baseboard-fan-symbolic</property>
                    <property name="title" translatable="yes">Reading the sensors…</property>
                    <property name="child">
                      <object class="GtkButton" id="details">
                        <property name="visible">False</property>
                        <property name="label" translatable="yes">Details</property>
                        <property name="halign">center</property>
                        <property name="action-name">win.show-system</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">fans</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="scrolled">
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="AdwClamp">
                        <property name="maximum-size">940</property>
                        <property name="tightening-threshold">700</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">24</property>
                            <property name="margin-top">24</property>
                            <property name="margin-bottom">36</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <child>
                              <object class="AdwPreferencesGroup" id="note_group">
                                <!-- A row with the parts and style classes
                                     of AdwActionRow, so that it looks the
                                     same, whose button goes under the text
                                     in a narrow window (D60). -->
                                <child>
                                  <object class="AdwPreferencesRow" id="note_row">
                                    <property name="activatable">False</property>
                                    <property name="child">
                                      <object class="GtkBox" id="note_header">
                                        <style>
                                          <class name="header"/>
                                        </style>
                                        <child>
                                          <object class="GtkImage">
                                            <property name="accessible-role">presentation</property>
                                            <property name="icon-name">help-about-symbolic</property>
                                            <style>
                                              <class name="icon"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkBox" id="note_texts">
                                            <property name="orientation">vertical</property>
                                            <property name="hexpand">True</property>
                                            <property name="valign">center</property>
                                            <style>
                                              <class name="title"/>
                                            </style>
                                            <child>
                                              <object class="GtkLabel" id="note_title">
                                                <property name="xalign">0</property>
                                                <property name="wrap">True</property>
                                                <property name="wrap-mode">word-char</property>
                                                <style>
                                                  <class name="title"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child>
                                              <object class="GtkLabel" id="note_subtitle">
                                                <property name="visible">False</property>
                                                <property name="xalign">0</property>
                                                <property name="wrap">True</property>
                                                <property name="wrap-mode">word-char</property>
                                                <style>
                                                  <class name="subtitle"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <!-- Opens the kernel section of the
                                             project's website (D60). -->
                                        <child>
                                          <object class="GtkButton" id="kernel_button">
                                            <property name="visible">False</property>
                                            <property name="valign">center</property>
                                            <property name="child">
                                              <object class="GtkBox">
                                                <property name="spacing">6</property>
                                                <child>
                                                  <object class="GtkLabel">
                                                    <property name="label" translatable="yes" comments="A button on the Fans page that opens the website's section on fan control in the kernel.">Kernel Status</property>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkImage">
                                                    <property name="icon-name">adw-external-link-symbolic</property>
                                                    <property name="accessible-role">presentation</property>
                                                  </object>
                                                </child>
                                              </object>
                                            </property>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <!-- The description comes from fans.rs. -->
                              <object class="AdwPreferencesGroup" id="source_group">
                                <property name="title" translatable="yes">Temperature source</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="cards_group">
                                <property name="title" translatable="yes">Headers</property>
                                <property name="description" translatable="yes">In the order of the headers on the board</property>
                                <!-- The legend of the charts (D60): whole
                                     items wrap, never a text. fans.rs fills
                                     it and shows it with charts. -->
                                <child>
                                  <object class="AdwWrapBox" id="legend">
                                    <property name="visible">False</property>
                                    <property name="accessible-role">group</property>
                                    <property name="child-spacing">22</property>
                                    <property name="line-spacing">6</property>
                                    <style>
                                      <class name="fan-chart-legend"/>
                                    </style>
                                  </object>
                                </child>
                                <!-- fans.rs adds the grid of cards here
                                     (fans/layout.rs, D61). -->
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="read_only_group">
                                <property name="title" translatable="yes">Read only</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
