<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <!-- The Fans page (docs/PROJEKT.md §5.5.4, §7 M2, M2.4): a note on top,
       the temperature source, the cards of the headers, the headers
       without control. fans.rs fills the groups; below 760 sp the cards
       stand in one column, below 560 sp a card puts its speed under its
       name. -->
  <template class="BaseboardFansPage" parent="AdwBin">
    <property name="child">
      <object class="AdwBreakpointBin" id="bin">
        <property name="width-request">360</property>
        <property name="height-request">200</property>
        <child>
          <object class="AdwBreakpoint" id="one_column">
            <condition>max-width: 760sp</condition>
          </object>
        </child>
        <child>
          <object class="AdwBreakpoint" id="narrow">
            <condition>max-width: 560sp</condition>
          </object>
        </child>
        <property name="child">
          <object class="GtkStack" id="stack">
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">status</property>
                <property name="child">
                  <object class="AdwStatusPage" id="status">
                    <property name="icon-name">baseboard-fan-symbolic</property>
                    <property name="title" translatable="yes">Reading the sensors…</property>
                    <property name="child">
                      <object class="GtkButton" id="details">
                        <property name="visible">False</property>
                        <property name="label" translatable="yes">Details</property>
                        <property name="halign">center</property>
                        <property name="action-name">win.show-system</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">fans</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="scrolled">
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="AdwClamp">
                        <property name="maximum-size">940</property>
                        <property name="tightening-threshold">700</property>
                        <property name="child">
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">24</property>
                            <property name="margin-top">24</property>
                            <property name="margin-bottom">36</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <child>
                              <object class="AdwPreferencesGroup" id="note_group">
                                <child>
                                  <object class="AdwActionRow" id="note_row">
                                    <property name="use-markup">False</property>
                                    <child type="prefix">
                                      <object class="GtkImage" id="note_icon">
                                        <property name="accessible-role">presentation</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="source_group">
                                <property name="title" translatable="yes">Temperature source</property>
                                <property name="description" translatable="yes">The board's controller computes the duty cycles of the curves from this temperature.</property>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="cards_group">
                                <property name="title" translatable="yes">Headers</property>
                                <property name="description" translatable="yes">In the order of the headers on the board</property>
                                <!-- Rows of two cards as high as the
                                     higher one, or one column. -->
                                <child>
                                  <object class="GtkGrid" id="cards">
                                    <property name="column-homogeneous">True</property>
                                    <property name="column-spacing">18</property>
                                    <property name="row-spacing">18</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child>
                              <object class="AdwPreferencesGroup" id="read_only_group">
                                <property name="title" translatable="yes">Read only</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
