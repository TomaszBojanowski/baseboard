<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <!-- The Fans page (docs/PROJEKT.md §5.5.4, §7 M2, M2.4, D62): the
       temperature the curves follow, large; under it the list of the fans,
       as wide as in GNOME Settings. fans.rs fills it. The breakpoints lay
       out the curve page (below 760 sp) and the rows of the list (below
       620 sp, where the list gets narrower than 600 sp). -->
  <template class="BaseboardFansPage" parent="AdwBin">
    <property name="child">
      <object class="AdwBreakpointBin" id="bin">
        <property name="width-request">360</property>
        <property name="height-request">200</property>
        <child>
          <object class="AdwBreakpoint" id="one_column">
            <condition>max-width: 760sp</condition>
          </object>
        </child>
        <child>
          <object class="AdwBreakpoint" id="narrow">
            <condition>max-width: 620sp</condition>
          </object>
        </child>
        <property name="child">
          <object class="GtkStack" id="stack">
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">status</property>
                <property name="child">
                  <object class="AdwStatusPage" id="status">
                    <property name="icon-name">baseboard-fan-symbolic</property>
                    <property name="title" translatable="yes">Reading the sensors…</property>
                    <property name="child">
                      <object class="GtkButton" id="details">
                        <property name="visible">False</property>
                        <property name="label" translatable="yes">Details</property>
                        <property name="halign">center</property>
                        <property name="action-name">win.show-system</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">fans</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="scrolled">
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="margin-top">24</property>
                        <property name="margin-bottom">36</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <!-- The temperature, large, with what it is. -->
                        <child>
                          <object class="GtkBox" id="hero">
                            <property name="orientation">vertical</property>
                            <property name="halign">center</property>
                            <property name="margin-top">10</property>
                            <property name="margin-bottom">22</property>
                            <style>
                              <class name="fan-hero"/>
                            </style>
                            <child>
                              <object class="GtkLabel" id="hero_label">
                                <style>
                                  <class name="fan-hero-label"/>
                                </style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <property name="halign">center</property>
                                <child>
                                  <object class="GtkLabel" id="hero_value">
                                    <style>
                                      <class name="fan-hero-value"/>
                                      <class name="numeric"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="hero_unit">
                                    <property name="label">°C</property>
                                    <property name="valign">start</property>
                                    <style>
                                      <class name="fan-hero-unit"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <!-- Always in place, so that the list does not
                                 move when it shows (D62). -->
                            <child>
                              <object class="GtkLabel" id="speeding">
                                <property name="label" translatable="yes" comments="Under the large temperature on the Fans page, while a fan speeds up to the duty cycle of its curve.">Fans are speeding up</property>
                                <property name="opacity">0</property>
                                <property name="margin-top">4</property>
                                <style>
                                  <class name="dimmed"/>
                                </style>
                              </object>
                            </child>
                            <!-- On a driver without control: a lasting
                                 state, so it may take more room. -->
                            <child>
                              <object class="AdwClamp">
                                <property name="maximum-size">560</property>
                                <property name="unit">sp</property>
                                <property name="child">
                                  <object class="GtkLabel" id="kernel">
                                    <property name="visible">False</property>
                                    <property name="use-markup">True</property>
                                    <property name="wrap">True</property>
                                    <property name="justify">center</property>
                                    <property name="margin-top">10</property>
                                  </object>
                                </property>
                              </object>
                            </child>
                          </object>
                        </child>
                        <!-- The list as wide as in GNOME Settings; it grows
                             with the size of the text. -->
                        <child>
                          <object class="AdwClamp">
                            <property name="maximum-size">600</property>
                            <property name="tightening-threshold">400</property>
                            <property name="unit">sp</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">18</property>
                                <child>
                                  <object class="GtkListBox" id="list">
                                    <property name="selection-mode">none</property>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="footer">
                                    <property name="wrap">True</property>
                                    <property name="justify">center</property>
                                    <style>
                                      <class name="caption"/>
                                      <class name="dimmed"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
