<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <!-- The Fans page (docs/PROJEKT.md §5.5.4, §7 M2, M2.4, D62, D67): the
       processor's card, the same as on the Overview, beside the list of
       the fans, or above it in a narrow window. fans.rs fills it and lays
       it out by the widths of layout.rs. -->
  <template class="BaseboardFansPage" parent="AdwBin">
    <property name="child">
      <object class="AdwBreakpointBin" id="bin">
        <property name="width-request">360</property>
        <property name="height-request">200</property>
        <property name="child">
          <object class="GtkStack" id="stack">
            <property name="transition-type">crossfade</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">status</property>
                <property name="child">
                  <object class="AdwStatusPage" id="status">
                    <property name="icon-name">baseboard-fan-symbolic</property>
                    <property name="title" translatable="yes">Reading the sensors…</property>
                    <property name="child">
                      <object class="GtkButton" id="details">
                        <property name="visible">False</property>
                        <property name="label" translatable="yes">Details</property>
                        <property name="halign">center</property>
                        <property name="action-name">win.show-system</property>
                        <style>
                          <class name="pill"/>
                        </style>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
            <child>
              <object class="GtkStackPage">
                <property name="name">fans</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="scrolled">
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="AdwClamp" id="clamp">
                        <property name="child">
                          <!-- A stopped CPU fan (D65) puts a warning on top
                               (fans.rs), above the card and the list. -->
                          <object class="GtkBox" id="content">
                            <property name="orientation">vertical</property>
                            <property name="spacing">18</property>
                            <property name="margin-top">24</property>
                            <property name="margin-bottom">36</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <child>
                              <object class="GtkGrid" id="columns">
                                <property name="column-spacing">24</property>
                                <property name="row-spacing">18</property>
                                <property name="column-homogeneous">True</property>
                              </object>
                            </child>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
  <!-- The processor's card (fans.rs puts it first) and, on a driver
       without control, what the kernel can do. -->
  <object class="GtkBox" id="side">
    <property name="orientation">vertical</property>
    <property name="spacing">12</property>
    <property name="valign">start</property>
    <child>
      <!-- The sentence with its link; the icon of the link stands in the
           room left for it at the end of the link. -->
      <object class="GtkOverlay" id="kernel_box">
        <property name="visible">False</property>
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>
        <property name="child">
          <object class="GtkLabel" id="kernel">
            <property name="use-markup">True</property>
            <property name="wrap">True</property>
            <property name="xalign">0</property>
            <style>
              <class name="fan-kernel"/>
            </style>
          </object>
        </property>
        <child type="overlay">
          <object class="GtkImage" id="kernel_icon">
            <property name="icon-name">adw-external-link-symbolic</property>
            <property name="pixel-size">14</property>
            <property name="can-target">False</property>
            <property name="accessible-role">presentation</property>
            <style>
              <class name="accent"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>
  <!-- The list as wide as in GNOME Settings at most; it grows with the
       size of the text, and takes the whole 600 sp as soon as its column
       has them, so that the sentences of its rows fit beside the card. -->
  <object class="AdwClamp" id="list_clamp">
    <property name="maximum-size">600</property>
    <property name="tightening-threshold">600</property>
    <property name="unit">sp</property>
    <property name="valign">start</property>
    <property name="child">
      <object class="GtkBox" id="list_column">
        <property name="orientation">vertical</property>
        <property name="spacing">18</property>
        <child>
          <object class="GtkListBox" id="list">
            <property name="selection-mode">none</property>
            <style>
              <class name="boxed-list"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="footer">
            <property name="wrap">True</property>
            <property name="justify">center</property>
            <style>
              <class name="caption"/>
              <class name="dimmed"/>
            </style>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
