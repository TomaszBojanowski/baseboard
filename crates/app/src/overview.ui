<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <!-- The Overview page (docs/PROJEKT.md §5.1, D64): a warning, three
       large numbers and a short list in one column as wide as the list of
       the Fans page; every reading on the page "All Sensors" below. The
       numbers and rows are made in overview.rs. -->
  <template class="BaseboardOverviewPage" parent="AdwBin">
    <property name="child">
      <object class="AdwBreakpointBin" id="bin">
        <property name="width-request">360</property>
        <property name="height-request">200</property>
        <child>
          <object class="AdwBreakpoint" id="narrow">
            <condition>max-width: 500sp</condition>
          </object>
        </child>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <!-- Shown when the board's chip is missing (overview.rs). -->
              <object class="AdwBanner" id="banner">
                <property name="button-label" translatable="yes">Details</property>
                <property name="action-name">win.show-system</property>
              </object>
            </child>
            <child>
              <object class="GtkStack" id="stack">
                <property name="vexpand">True</property>
                <property name="transition-type">crossfade</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">status</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="status">
                        <property name="icon-name">baseboard-overview-symbolic</property>
                        <property name="title" translatable="yes">Reading the sensors…</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">summary</property>
                    <property name="child">
                      <object class="GtkScrolledWindow" id="scrolled">
                        <property name="hscrollbar-policy">never</property>
                        <property name="child">
                          <!-- As wide as the list of the Fans page. -->
                          <object class="AdwClamp">
                            <property name="maximum-size">600</property>
                            <property name="tightening-threshold">400</property>
                            <property name="unit">sp</property>
                            <property name="child">
                              <object class="GtkBox" id="column">
                                <property name="orientation">vertical</property>
                                <property name="spacing">24</property>
                                <property name="margin-top">24</property>
                                <property name="margin-bottom">36</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">12</property>
                                <child>
                                  <object class="GtkBox" id="heroes">
                                    <property name="homogeneous">True</property>
                                    <property name="spacing">6</property>
                                    <style>
                                      <class name="hero"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkListBox" id="list">
                                    <property name="selection-mode">none</property>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkListBox" id="all_list">
                                    <property name="selection-mode">none</property>
                                    <style>
                                      <class name="boxed-list"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
  <!-- "All Sensors": every reading in its group with its source and range,
       pushed over the page by the window. Two columns when wide. -->
  <object class="AdwNavigationPage" id="sensors_page">
    <property name="title" translatable="yes">All Sensors</property>
    <property name="tag">sensors</property>
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="AdwBreakpointBin">
            <property name="width-request">360</property>
            <property name="height-request">200</property>
            <child>
              <object class="AdwBreakpoint" id="wide">
                <condition>min-width: 760sp</condition>
              </object>
            </child>
            <property name="child">
              <object class="GtkScrolledWindow" id="sensors_scrolled">
                <property name="hscrollbar-policy">never</property>
                <property name="child">
                  <object class="AdwClamp">
                    <property name="maximum-size">1200</property>
                    <property name="tightening-threshold">1000</property>
                    <property name="child">
                      <object class="GtkBox">
                        <property name="spacing">24</property>
                        <property name="homogeneous">True</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">24</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkBox" id="left">
                            <property name="orientation">vertical</property>
                            <property name="spacing">24</property>
                            <property name="valign">start</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox" id="right">
                            <property name="orientation">vertical</property>
                            <property name="spacing">24</property>
                            <property name="valign">start</property>
                            <property name="visible">False</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
