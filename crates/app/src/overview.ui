<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <!-- The Overview page (docs/PROJEKT.md §5.1). The groups are made in
       overview.rs; with the page wide they stand in two columns, with it
       narrow in one, in the order of §5.1. -->
  <template class="BaseboardOverviewPage" parent="AdwBin">
    <property name="child">
      <object class="AdwBreakpointBin">
        <property name="width-request">360</property>
        <property name="height-request">200</property>
        <child>
          <object class="AdwBreakpoint" id="wide">
            <condition>min-width: 760sp</condition>
          </object>
        </child>
        <property name="child">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <!-- Shown when the board's chip is missing (overview.rs). -->
              <object class="AdwBanner" id="banner">
                <property name="button-label" translatable="yes">Details</property>
                <property name="action-name">win.show-system</property>
              </object>
            </child>
            <child>
              <object class="GtkStack" id="stack">
                <property name="vexpand">True</property>
                <property name="transition-type">crossfade</property>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">status</property>
                    <property name="child">
                      <object class="AdwStatusPage" id="status">
                        <property name="icon-name">baseboard-overview-symbolic</property>
                        <property name="title" translatable="yes">Reading the sensors…</property>
                      </object>
                    </property>
                  </object>
                </child>
                <child>
                  <object class="GtkStackPage">
                    <property name="name">readings</property>
                    <property name="child">
                      <object class="GtkScrolledWindow" id="scrolled">
                        <property name="hscrollbar-policy">never</property>
                        <property name="child">
                          <object class="AdwClamp">
                            <property name="maximum-size">1200</property>
                            <property name="tightening-threshold">1000</property>
                            <property name="child">
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="spacing">18</property>
                                <property name="margin-top">12</property>
                                <property name="margin-bottom">24</property>
                                <property name="margin-start">12</property>
                                <property name="margin-end">12</property>
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label" translatable="yes" comments="Above the readings of the Overview, and under the temperature source on the Fans page, where it follows another sentence on one line: keep it short.">Gray range: minimum and maximum since the app started.</property>
                                    <property name="xalign">0</property>
                                    <property name="wrap">True</property>
                                    <style>
                                      <class name="caption"/>
                                      <class name="dimmed"/>
                                    </style>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">24</property>
                                    <property name="homogeneous">True</property>
                                    <child>
                                      <object class="GtkBox" id="left">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">24</property>
                                        <property name="valign">start</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="right">
                                        <property name="orientation">vertical</property>
                                        <property name="spacing">24</property>
                                        <property name="valign">start</property>
                                        <property name="visible">False</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
